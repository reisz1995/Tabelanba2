# Supabase (Obrigatório)
SUPABASE_URL=https://your-project.supabase.co
# Chave Service Role com permissão de escrita/bypassing RLS para pipelines
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Alternativa aceita em alguns scripts:
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq Cloud (Obrigatório para predict_games.py)
GROQ_API_KEY=gsk_your_groq_api_key

# ScrapingAnt (Opcional - fallback para bypass de bloqueios no Scores24)
SCRAPINGANT_API_KEY=

# Databallr (Opcional - por padrão a temporada é derivada automaticamente da data;
# defina aqui apenas para forçar uma temporada específica)
# DATABALLR_SEASON=2026-27

# OpenAI (Opcional - usado em src/opencode.js)
OPENAI_API_KEY=
